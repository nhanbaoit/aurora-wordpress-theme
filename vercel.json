{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"rewrites": [
		{
			"source": "/",
			"destination": "/preview/index.html"
		},
		{
			"source": "/index.html",
			"destination": "/preview/index.html"
		},
		{
			"source": "/blog.html",
			"destination": "/preview/blog.html"
		},
		{
			"source": "/post.html",
			"destination": "/preview/post.html"
		},
		{
			"source": "/contact.html",
			"destination": "/preview/contact.html"
		},
		{
			"source": "/assets/(.*)",
			"destination": "/preview/assets/$1"
		}
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{
					"key": "X-Content-Type-Options",
					"value": "nosniff"
				},
				{
					"key": "X-Frame-Options",
					"value": "DENY"
				},
				{
					"key": "Referrer-Policy",
					"value": "strict-origin-when-cross-origin"
				}
			]
		}
	]
}
